# =============================================================================
# Full Stack Environment Variables (Local Dev & Production)
# =============================================================================

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://drawapp:drawapp_secret@localhost:5432/drawapp?schema=public
POSTGRES_USER=drawapp
POSTGRES_PASSWORD=drawapp_secret
POSTGRES_DB=drawapp

# --- Backend JWT Secret (used by http-backend to sign and verify tokens) ---
JWT_SECRET=production_jwt_secret_change_me_in_env_at_least_32_chars

# --- NextAuth Configuration (apps/fe) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=production_nextauth_secret_change_me_in_env_at_least_32_chars

# --- Frontend Connection to Backends ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:3002

# --- Allowed Origins for Backend CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- (Optional) OAuth Logins for NextAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# --- (Optional) AI Diagram Generation API Keys ---
# Google Gemini (Free tier: https://aistudio.google.com):
GEMINI_API_KEY=

# OpenAI (https://platform.openai.com):
OPENAI_API_KEY=

# Groq (https://console.groq.com):
GROQ_API_KEY=

DEFAULT_AI_MODEL=gemini-2.0-flash
