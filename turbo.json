{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "@repo/db#build": {
            "cache": false
        },
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"],
            "env": [
                "DATABASE_URL",
                "JWT_SECRET",
                "NEXT_PUBLIC_BACKEND_URL",
                "NEXT_PUBLIC_WS_URL",
                "NEXTAUTH_URL",
                "NEXTAUTH_SECRET",
                "ALLOWED_ORIGINS",
                "GITHUB_TOKEN_ENCRYPTION_KEY",
                "GOOGLE_CLIENT_ID",
                "GOOGLE_CLIENT_SECRET",
                "GITHUB_ID",
                "GITHUB_SECRET",
                "GITHUB_CLIENT_ID",
                "GITHUB_CLIENT_SECRET",
                "GEMINI_API_KEY",
                "OPENAI_API_KEY",
                "ANTHROPIC_API_KEY",
                "GROQ_API_KEY",
                "DEFAULT_AI_MODEL",
                "NEXT_STANDALONE"
            ]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}