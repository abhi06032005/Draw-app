{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"],
            "env": [
                "NEXT_PUBLIC_BACKEND_URL",
                "NEXT_PUBLIC_WS_URL",
                "NEXTAUTH_URL",
                "NEXTAUTH_SECRET",
                "GOOGLE_CLIENT_ID",
                "GOOGLE_CLIENT_SECRET",
                "GITHUB_ID",
                "GITHUB_SECRET",
                "GEMINI_API_KEY",
                "OPENAI_API_KEY",
                "GROQ_API_KEY",
                "DEFAULT_AI_MODEL"
            ]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "check-types": {
            "dependsOn": ["^check-types"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}